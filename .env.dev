# ============================================================
# DCR Queue Polling Service — DEV Environment
# ============================================================
# Usage: APP_ENV=dev python main.py
# ============================================================

# ---------------------------------------------------------------
# SQL Server — Drawing Hub Database (DEV)
# ---------------------------------------------------------------
MSSQL_HOST=<DEV_SQL_SERVER_HOST>
MSSQL_PORT=1433
MSSQL_DATABASE=DrawingHub
MSSQL_USERNAME=<DEV_SQL_USER>
MSSQL_PASSWORD=<DEV_SQL_PASSWORD>
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ---------------------------------------------------------------
# Automated DCR Backend Service (3KT — DEV via APIM)
# ---------------------------------------------------------------
EXTERNAL_API_BASE_URL=https://cp-apim-dev.azure-api.net/polling-api

# ---------------------------------------------------------------
# Polling behaviour
# ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=10
MAX_CONCURRENT_JOBS=3
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5.0

# ---------------------------------------------------------------
# APIM Authentication — Subscription Key (DEV)
# Get from: Azure Portal → APIM → Subscriptions → Primary Key
# ---------------------------------------------------------------
APIM_SUBSCRIPTION_KEY=1087e16a0d424b0baae26dc45e6a0218

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/service.log
