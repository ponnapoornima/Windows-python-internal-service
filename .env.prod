# ============================================================
# DCR Queue Polling Service — PRODUCTION Environment
# ============================================================
# Usage: APP_ENV=prod python main.py
# ============================================================

# ---------------------------------------------------------------
# PostgreSQL — PRODUCTION Drawing-HUB Database
# ---------------------------------------------------------------
PG_HOST=<PROD_PG_HOST>
PG_PORT=5432
PG_DATABASE=Drawing-HUB
PG_USERNAME=<PROD_PG_USER>
PG_PASSWORD=<PROD_PG_PASSWORD>
PG_SSLMODE=require

# ---------------------------------------------------------------
# Automated DCR Backend Service (3KT — PRODUCTION)
# ---------------------------------------------------------------
EXTERNAL_API_BASE_URL=https://<PROD_BACKEND_HOST>/AutomatedDCRService

# ---------------------------------------------------------------
# PDF Source Directory — Client network share (PROD)
# ---------------------------------------------------------------
PDF_SOURCE_DIR=\\<PROD_FILE_SERVER>\drawings\dcr-source

# ---------------------------------------------------------------
# Result PDF Save Path — Client network share (PROD)
# ---------------------------------------------------------------
RESULT_PDF_SAVE_PATH=\\<PROD_FILE_SERVER>\drawings\compare-results

# ---------------------------------------------------------------
# Polling behaviour — More conservative in production
# ---------------------------------------------------------------
POLL_INTERVAL_SECONDS=15
MAX_CONCURRENT_JOBS=5
REQUEST_TIMEOUT_SECONDS=180
MAX_RETRIES=5
RETRY_DELAY_SECONDS=10.0

# ---------------------------------------------------------------
# APIM Authentication — Subscription Key (PROD)
# Get from: Azure Portal → APIM → Subscriptions → Primary Key
# ---------------------------------------------------------------
APIM_SUBSCRIPTION_KEY=<PROD_APIM_SUBSCRIPTION_KEY>

# ---------------------------------------------------------------
# Logging — WARNING level in prod to reduce noise
# ---------------------------------------------------------------
LOG_LEVEL=WARNING
LOG_FILE=logs/service.log
